FROM python:3.12-slim AS base

# Install Node.js 22 (needed for npx-based MCP servers like @anthropic/slack-mcp-server)
# Also install socat (used for auth port forwarding during cbcl setup) and
# openssh-client so agents can ``ssh`` / ``scp`` / ``rsync`` to user-
# specified targets. SSH key material is NOT baked into the image —
# users bring their own key via the office's "Extra mounts" config,
# mounted read-only into /home/agent/.ssh/.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git socat openssh-client poppler-utils && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Runtime of Anthropic's document skills in the skill catalog (docx, pdf,
# pptx, xlsx — the "Dependencies" section of each SKILL.md). The container
# runs as the non-root ``agent`` user, so nothing can be added at run time
# and a ``pip install --user`` is lost when the container is recreated.
#   - LibreOffice (headless ``-nogui`` builds): render .docx/.xlsx/.pptx to
#     PDF for visual QA and recalculate spreadsheet formulas.
#   - pandoc: read .docx; qpdf: merge/split/rotate/decrypt PDFs;
#     tesseract (+ English data): OCR scanned PDFs.
#   - Metric-compatible fonts (Liberation for Arial/Times/Courier, Carlito
#     for Calibri, Caladea for Cambria) so rendered layouts match Office.
# ``--no-install-recommends`` keeps optional extras out. Nothing AGPL is
# installed (no Ghostscript, no PyMuPDF); pdftk (Java) is skipped — the
# pdf skill marks it optional.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui \
        pandoc qpdf tesseract-ocr tesseract-ocr-eng \
        fonts-liberation fonts-crosextra-carlito fonts-crosextra-caladea \
        fonts-dejavu-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Global npm modules the docx and pptx skills ``require`` directly. Node does
# not search the global folder on its own, so NODE_PATH points ``require``
# there from any working directory.
RUN npm install -g --no-fund --no-audit "docx@9.7.2" "pptxgenjs@4.0.1" && \
    npm cache clean --force
ENV NODE_PATH=/usr/lib/node_modules

# Python packages the document skills import (markitdown reads .pptx and
# .xlsx; openpyxl/pandas write spreadsheets; pypdf, pdfplumber, pypdfium2,
# reportlab, pdf2image and pytesseract handle PDFs; Pillow, defusedxml and
# lxml back the Office XML scripts), plus imageio, which the slack-gif-creator
# skill writes its GIFs with (through Pillow; numpy comes with pandas). All
# permissively licensed. Installed before the Claude SDK layer so an SDK
# version bump does not rebuild it. The webapp-testing skill's Playwright and
# browser (several hundred MB) are deliberately not installed.
RUN pip install --no-cache-dir \
        "openpyxl==3.1.5" "pandas==3.0.6" "markitdown[pptx,xlsx]==0.1.8" \
        "pypdf==6.19.0" "pdfplumber==0.11.10" "reportlab==5.0.1" \
        "pytesseract==0.3.13" "pdf2image==1.17.0" "pypdfium2==5.13.0" \
        "pillow==12.3.0" "defusedxml==0.7.1" "lxml==6.1.3" \
        "imageio==2.37.4"

# Install Claude Agent SDK (includes Claude CLI binary), HTTP client, MCP SDK,
# and PyYAML (required by mcp_tool_server.py:_parse_manifest to parse a
# script's ``script.yaml`` before the in-container MCP path launches it).
# PyYAML used to come in transitively via one of the listed packages; a
# release of those packages dropped the transitive dep and every
# ``execute_script`` call started failing with ``No module named 'yaml'``.
# Pin it explicitly so the agent image is self-sufficient. The Anthropic API
# client is deliberately absent: Cubicle runs every Claude session on the
# office's Claude subscription login, never on an API key.
RUN pip install --no-cache-dir \
        "claude-agent-sdk==0.2.152" aiohttp mcp pyyaml && \
    # Symlink the bundled Claude CLI binary to PATH so docker exec can find it
    ln -sf "$(python3 -c 'import claude_agent_sdk; import pathlib; print(pathlib.Path(claude_agent_sdk.__file__).parent / "_bundled" / "claude")')" /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude

# Create a non-root user (Claude CLI refuses to run as root). UID
# 1000 is PINNED — every host-side daemon write that lands on the
# bind-mounted workspace gets ``chown 1000:1000`` so the agent can
# subsequently edit it. ``src/_chown.py:AGENT_UID`` mirrors this
# constant; a Dockerfile change that drifts the UID would break
# every chown silently. ``test_constants_match_dockerfile`` greps
# this line to assert the two stay in lock-step.
RUN useradd -m -u 1000 -s /bin/bash agent

# Pre-create the SSH config dir so users can ``--mount`` an
# individual key file (e.g. host ``~/.ssh/id_office`` →
# ``/home/agent/.ssh/id_ed25519``) without first creating the
# parent. 700 perms are what SSH requires; ownership is agent so
# the runtime user can read the directory listing.
RUN mkdir -p /home/agent/.ssh && \
    chmod 700 /home/agent/.ssh && \
    chown agent:agent /home/agent/.ssh

# Create workspace structure with correct ownership
RUN mkdir -p /workspace/.scripts /workspace/.claude/skills /workspace/.cubicle /workspace/outputs && \
    chown -R agent:agent /workspace

# Create cubicle tools directory
RUN mkdir -p /opt/cubicle && chown agent:agent /opt/cubicle

# Standalone MCP server for our custom tools (kanban, worker, script).
# Claude CLI spawns this as a child process — standard MCP pattern.
#
# P3-F: the entrypoint imports tool-definition lists and parameter
# transforms from a sibling ``_mcp`` package.
#
# Wave 11 (cbcl 0.2.32): the entrypoint ALSO imports
# ``_mcp_backend`` (singleton aiohttp session + ``_call_backend``)
# and ``_mcp_script_exec`` (the ``execute_script`` / ``monitor`` /
# ``get_script_status`` handlers). Both must be COPYed alongside the
# entrypoint or every spawn dies with
# ``ModuleNotFoundError: No module named '_mcp_script_exec'``,
# which presents to the AI Manager as "cubicle-tools MCP server
# disconnected" (the JSON-RPC handshake never starts because the
# subprocess crashes on import). ``_SOURCE_FILES`` in ``image_hash.py``
# is the matching cache-invalidation list — both files MUST be in both
# places. ``tests/test_agent_image_copy_sync.py`` fails if these COPY
# lines and ``image_hash.image_source_files()`` ever drift apart.
COPY mcp_tool_server.py /opt/cubicle/mcp_tool_server.py
COPY _mcp_backend.py /opt/cubicle/_mcp_backend.py
COPY _mcp_script_exec.py /opt/cubicle/_mcp_script_exec.py
COPY _mcp /opt/cubicle/_mcp
# PreToolUse Bash guard (Tier 3 worker-session-churn fix). Referenced by
# each agent's /workspace/agents/<name>/.claude/settings.json hook. Must
# also appear in ``image_hash._SOURCE_FILES`` so an edit invalidates
# the image cache (test_agent_image_copy_sync.py enforces the lockstep).
COPY bash_guard.py /opt/cubicle/bash_guard.py
COPY execution_pace.py /opt/cubicle/execution_pace.py

RUN mkdir -p /usr/local/libexec/cubicle
COPY secure_files.py /usr/local/libexec/cubicle/secure_files.py
COPY generation_runner.py /usr/local/libexec/cubicle/generation_runner.py
COPY generation_sources.py /usr/local/libexec/cubicle/generation_sources.py

USER agent
WORKDIR /workspace

# Container stays running — communicator invokes claude via docker exec
CMD ["tail", "-f", "/dev/null"]
